{
  "name": "ds-bot",
  "version": "0.2.18",
  "description": "DS Bot: a team of long-lived Bots for DeepSeek Harness, with Main Bots, Bot-to-Bot messages and group chats",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/ThinkFlowLab/FlyBot#readme",
  "bugs": {
    "url": "https://github.com/ThinkFlowLab/FlyBot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThinkFlowLab/FlyBot.git",
    "directory": "core"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json",
    "./types": {
      "types": "./types/flybot.d.ts"
    },
    "./workbench-gateway": "./src/host/workbench-gateway.js"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "client.js",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "types/",
    "workbench.js",
    "workbench.css",
    "workbench-native.js",
    "workbench-native.css",
    "workbench-fonts/"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-workbench.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "arch-docs": "node scripts/check-arch-docs.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh",
    "ci:local": "bash scripts/local-ci.sh",
    "install:doctor": "node scripts/install-doctor.mjs",
    "build:workbench": "node scripts/build-workbench.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@openai/codex-sdk": "0.166.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@shikijs/langs": "4.5.0",
    "@types/mdast": "4.0.4",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "immer": "10.2.0",
    "katex": "0.18.10",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.4",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.1.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "shiki": "4.5.0",
    "simple-icons": "16.31.0",
    "zustand": "4.5.7"
  },
  "types": "./types/flybot.d.ts"
}
